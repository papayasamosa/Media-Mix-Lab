# Claude Code
.claude/

# Confidential local input data and artifacts never belong in Git.
# `.local-data` is the canonical private input area. The path-specific
# patterns below catch common misplaced input directories as well.
.local-data/
**/.local-data/
**/local-data/
**/raw-data/
**/private-data/
*.xlsx
# The committed Dictionary Builder templates are safe, generated docs assets.
!docs/Ancestry_MMM_Activity_Dictionary_Builder.xlsx
!docs/Ancestry_MMM_Context_Dictionary_Builder.xlsx
!docs/Ancestry_MMM_Outcome_Dictionary_Builder.xlsx
*.xls
*.csv
# Safe, versioned synthetic examples are part of the application and docs.
!ancestry_mmm/sample_data/*.csv
!docs/fixtures/**/*.csv
*.parquet

# Model outputs
*.pkl
*.nc
*.netcdf
*.zarr/
*.h5
*.hdf5
ancestry_mmm/.fit_jobs/
*.joblib
traces/

# Frontend (Next.js)
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.env.local
next-env.d.ts

# Ancestry FH MMM - generated project data (curve bank runs, exports)
ancestry_mmm/.curve_bank_store/
ancestry_mmm/.curve_artifact_store/
ancestry_mmm/.project_exports/

# MCP dev tooling - local overrides and secrets never belong in the repo.
# .mcp.json itself IS committed deliberately (see docs/development/
# mcp_development_tooling.md) - it holds no secrets: GitHub uses OAuth,
# Context7 runs unauthenticated, Playwright needs no credentials, and the
# graphify-project entry just launches a local stdio process.
.env.mcp
mcp.local.json
*.mcp.local.json
config/mcp/*.local.json
config/mcp/*.env
!config/mcp/*.env.example
test-artifacts/playwright-mcp/
# Browser test failure evidence (screenshots, traces, server logs) - written
# to this repo-relative path so CI's "Upload failure artefacts" step
# (.github/workflows/tests.yml, job `browser`) can find it, never committed.
test-artifacts/playwright/
# Local UK readiness reports and synthetic bundles stay outside Git.
test-artifacts/uk-readiness/
logs/mcp/
playwright/.auth/
storage-state.json

# Graphify - generated knowledge graph, rebuilt locally on demand (see
# docs/development/graphify.md for the build command and the reasoning
# behind not committing this directory: rebuild is one command, graph.json/
# graph.html are large, and community numbering is not stable across
# rebuilds). .graphifyignore (the exclusion list) IS committed.
graphify-out/

# Local project data - never commit
.local-data/
